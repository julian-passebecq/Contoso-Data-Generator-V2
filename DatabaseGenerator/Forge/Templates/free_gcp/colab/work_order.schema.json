{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso-forge.local/schemas/colab-work-order-1.3.json",
  "title": "Contoso Forge issued interactive work order 1.2/1.3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "artifactStatus",
    "status",
    "workOrderId",
    "runId",
    "issuedAt",
    "expiresAt",
    "datasetFingerprint",
    "sourceFileSha256",
    "truthManifestSha256",
    "packageFileSha256",
    "warehouse",
    "gcp",
    "resultPath"
  ],
  "properties": {
    "contractVersion": {
      "enum": [
        "1.2",
        "1.3"
      ]
    },
    "artifactStatus": {
      "const": "experimental"
    },
    "status": {
      "const": "issued"
    },
    "workOrderId": {
      "type": "string",
      "format": "uuid"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 250
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "datasetFingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "sourceFileSha256": {
      "$ref": "#/$defs/hashMap"
    },
    "truthManifestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "packageFileSha256": {
      "$ref": "#/$defs/hashMap"
    },
    "warehouse": {
      "const": "bigquery"
    },
    "gcp": {
      "type": "object",
      "required": [
        "projectId",
        "dataset",
        "location",
        "maximumBytesBilled"
      ],
      "properties": {
        "projectId": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "maximumBytesBilled": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "resultPath": {
      "const": "colab/result_manifest.json"
    },
    "executionScope": {
      "enum": [
        "spark",
        "spark-and-bigquery"
      ]
    },
    "requestedSparkApiMode": {
      "enum": [
        "classic",
        "connect-local",
        "connect-remote"
      ]
    },
    "sparkVersionPolicy": {
      "enum": [
        "colab-native",
        "pinned"
      ]
    },
    "requestedSparkVersion": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "hashMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contractVersion": {
            "const": "1.3"
          }
        }
      },
      "then": {
        "required": [
          "executionScope",
          "requestedSparkApiMode",
          "sparkVersionPolicy",
          "requestedSparkVersion"
        ]
      }
    }
  ]
}
