<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>   
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" Version="31.0.3" />
    <PackageReference Include="ExcelDataReader.DataSet" Version="3.6.0" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Parquet.Net" Version="4.23.5" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="assemblygithash.cs" />
    <None Remove="Forge\Templates\**\target\**" />
    <None Remove="Forge\Templates\**\logs\**" />
    <None Remove="Forge\Templates\**\dbt_packages\**" />
    <None Remove="Forge\Templates\**\__pycache__\**" />
    <None Remove="Forge\Templates\**\*.pyc" />
    <None Update="Forge\Templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateGitHashAssemblyInfo" BeforeTargets="CoreCompile">
    <Exec Command="git -c safe.directory=&quot;$(MSBuildProjectDirectory)/..&quot; rev-parse HEAD"
          Condition="'$(GitRevision)' == ''"
          ConsoleToMSBuild="true"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low">
      <Output TaskParameter="ConsoleOutput" ItemName="_GitRevisionOutput" />
      <Output TaskParameter="ExitCode" PropertyName="_GitRevisionExitCode" />
    </Exec>
    <PropertyGroup>
      <GitRevision Condition="'$(GitRevision)' == '' and '$(_GitRevisionExitCode)' == '0'">@(_GitRevisionOutput)</GitRevision>
      <GitRevision Condition="'$(GitRevision)' == ''">unknown</GitRevision>
      <GitAssemblyInfo>$(IntermediateOutputPath)assemblygithash.cs</GitAssemblyInfo>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(GitAssemblyInfo)"
                      Lines="[assembly: System.Reflection.AssemblyProduct(&quot;DatabaseGeneratorV2 - $(GitRevision)&quot;)]"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <ItemGroup>
      <Compile Include="$(GitAssemblyInfo)" />
    </ItemGroup>
  </Target>
 
</Project>
