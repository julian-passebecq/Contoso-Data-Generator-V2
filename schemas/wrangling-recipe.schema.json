{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso.example/schemas/forge/wrangling-recipe.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recipeVersion",
    "steps"
  ],
  "properties": {
    "recipeVersion": {
      "const": 1
    },
    "maxRows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "op"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "entity": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "input": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "right": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "field": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "op": {
            "enum": [
              "source",
              "select",
              "rename",
              "cast",
              "derive",
              "filter",
              "join",
              "lookup",
              "conditional-split",
              "aggregate",
              "deduplicate",
              "window",
              "sink"
            ]
          },
          "how": {
            "enum": [
              "inner",
              "left"
            ]
          },
          "matched": {
            "type": "boolean"
          },
          "function": {
            "enum": [
              "row_number",
              "sum"
            ]
          },
          "columns": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "groupBy": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "orderBy": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "renames": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            }
          },
          "casts": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "enum": [
                "int64",
                "float64",
                "string",
                "boolean"
              ]
            }
          },
          "expression": {
            "$ref": "#/$defs/expression"
          },
          "predicate": {
            "$ref": "#/$defs/expression"
          },
          "measures": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "name",
                "function"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "field": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
                },
                "function": {
                  "enum": [
                    "count",
                    "sum",
                    "mean",
                    "min",
                    "max"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "operator": {
          "enum": [
            "+",
            "-",
            "*",
            "/",
            "==",
            "!=",
            ">",
            ">=",
            "<",
            "<=",
            "and",
            "or",
            "not",
            "is-null",
            "coalesce"
          ]
        },
        "args": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/expression"
          }
        }
      }
    }
  }
}
