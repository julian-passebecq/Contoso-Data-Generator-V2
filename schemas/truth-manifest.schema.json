{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contoso.example/schemas/forge/truth-manifest-v1.json",
  "title": "Contoso Forge Truth Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "artifactStatus",
    "scenario",
    "seed",
    "generationEpoch",
    "projectFingerprint",
    "datasetFingerprint",
    "sourceRowCounts",
    "expectedSilverRowCounts",
    "expectedKpis",
    "sourceFileSha256",
    "evidence",
    "invariants"
  ],
  "properties": {
    "version": { "const": "1.0.0" },
    "artifactStatus": { "enum": ["validated", "starter/reference", "unsupported"] },
    "scenario": { "const": "retail.customer_satisfaction" },
    "seed": { "type": "integer", "minimum": 0 },
    "generationEpoch": { "type": "string", "format": "date-time" },
    "projectFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "datasetFingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceRowCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "expectedSilverRowCounts": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
    "expectedKpis": { "type": "object", "additionalProperties": { "type": "number" } },
    "sourceFileSha256": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "injector", "entity", "recordKeys", "expectedEffect", "details"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" },
          "injector": { "enum": ["cdc", "duplicate", "late_arrival", "scd2", "quality"] },
          "entity": { "type": "string", "minLength": 1 },
          "recordKeys": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "expectedEffect": { "type": "string", "minLength": 1 },
          "details": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "foreignKeysValid", "rawToLakeContract"],
      "properties": {
        "deterministic": { "const": true },
        "foreignKeysValid": { "const": true },
        "rawToLakeContract": { "type": "string", "minLength": 1 }
      }
    }
  }
}
